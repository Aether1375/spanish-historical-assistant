import { GoogleGenerativeAI } from "@google/generative-ai";

const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);

export default async function handler(req, res) {
  // CORS setup
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
  if (req.method === 'OPTIONS') return res.status(200).end();

  if (req.method !== "POST") return res.status(405).json({ error: "Method not allowed" });

  const { imageBase64, userMemoryPrompt, spanishDictionary } = req.body;

  try {
    const model = genAI.getGenerativeModel({ 
      model: "gemini-1.5-flash",
      generationConfig: { responseMimeType: "application/json" }
    });

    const prompt = `
      Extract historical Spanish index record data from this image frame.
      Layout instructions: "${userMemoryPrompt || 'Standard Spanish Index Page'}".
      Validation dictionary words: ${JSON.stringify(spanishDictionary || [])}.

      Return raw JSON matching this structure exactly:
      {
        "fields": {
          "Nombre": "extracted text",
          "Apellidos": "extracted text",
          "Folio": "extracted text",
          "Tomo": "extracted text",
          "Ano": "extracted text"
        },
        "confidenceScore": number (0 to 100),
        "unrecognizedWords": ["word1", "word2"]
      }
    `;

    const imagePart = {
      inlineData: {
        data: imageBase64.replace(/^data:image\/\w+;base64,/, ""),
        mimeType: "image/jpeg"
      }
    };

    const result = await model.generateContent([prompt, imagePart]);
    const responseData = JSON.parse(result.response.text());

    // Evaluate confidence against dictionary threshold (<90%)
    if (responseData.confidenceScore < 90 || (responseData.unrecognizedWords && responseData.unrecognizedWords.length > 0)) {
      responseData.needsAssistance = true;
    }

    return res.status(200).json(responseData);

  } catch (error) {
    return res.status(500).json({ error: error.message });
  }
}